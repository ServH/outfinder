          "width": "fill_container",
          "content": "i18n (namespace colorCapture)\n• colorCapture.scanBanner → 'Escanea una prenda'\n• colorCapture.scanBannerA11y → 'Escanea una prenda'\n• Añadir en en.json + es.json",
          "fontFamily": "Inter",
          "fontSize": 13
        },
