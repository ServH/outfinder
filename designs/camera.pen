        },
        {
          "type": "text",
          "id": "0gwtf",
          "name": "spTypo",
          "fill": "#f5efe6",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Tipografía\n• Familia: Inter_500Medium · 15pt\n• Ícono cámara: SF Symbol 'camera' · 22pt\n• Chevron: SF Symbol 'chevron.right' · 16pt\n• Gap ícono → texto: 10pt",
          "fontFamily": "Inter",
          "fontSize": 13
        },
        {
          "type": "text",
          "id": "GKA7c",
          "name": "spStates",
          "fill": "#f5efe6",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Estados interactivos\n• Normal: opacity 1.0\n• Pressed: opacity 0.88 (igual que rest app)\n• Sin animación de entrada — estático",
          "fontFamily": "Inter",
          "fontSize": 13
        },
        {
          "type": "text",
          "id": "lfonG",
          "name": "spA11y",
          "fill": "#f5efe6",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Accesibilidad\n• accessibilityRole='button'\n• accessibilityLabel EN: 'Scan a garment'\n• accessibilityLabel ES: 'Escanea una prenda'\n• testID='camera-scan-banner'",
