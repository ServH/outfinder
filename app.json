{
  "expo": {
    "name": "Outfinder",
    "slug": "outfinder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "outfinder",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.alejandrocamps.outfinder",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fafaf8"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "4c5d0a44-4f09-4d97-8169-e85343dd3d18"
      }
    },
    "owner": "servh"
  }
}
