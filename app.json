{
  "expo": {
    "name": "Outfinder",
    "slug": "outfinder",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "outfinder",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.alejandrocamps.outfinder",
      "buildNumber": "5",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Outfinder uses your camera to identify garment colors and find Wada combinations.",
        "NSPhotoLibraryUsageDescription": "Outfinder necesita acceso a tus fotos para añadir prendas a tu Armario."
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fafaf8"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      "expo-localization",
      "expo-camera",
      [
        "expo-image-picker",
        {
          "photosPermission": "Outfinder necesita acceso a tus fotos para añadir prendas a tu Armario."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "4c5d0a44-4f09-4d97-8169-e85343dd3d18"
      }
    },
    "owner": "servh",
    "android": {
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.alejandrocamps.outfinder"
    }
  }
}
